# Public access requires no key. Export a real key in the host environment if desired.
OPENDOTA_BASE_URL=https://api.opendota.com/api
OPENDOTA_CONNECT_TIMEOUT=5
OPENDOTA_READ_TIMEOUT=20
OPENDOTA_MAX_ATTEMPTS=3
OPENDOTA_RETRY_DELAY_BUDGET=10
OPENDOTA_RETRY_BASE_DELAY=0.25
OPENDOTA_RETRY_DELAY_CAP=5
OPENDOTA_SNAPSHOT_TTL_SECONDS=1800
OPENDOTA_SNAPSHOT_CAPACITY=32

